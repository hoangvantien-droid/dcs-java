# /etc/systemd/system/dcs-jobs.service  +  dcs-jobs.timer
# Tác vụ nền chạy hằng ngày: chuyển hiệu lực theo lịch, sinh rà soát, leo thang,
# dọn phiên (DCS-6 §3, QĐ-H). Chạy RỜI khỏi tiến trình web để trả sạch bộ nhớ
# trên máy 1 GB (DCS-8 §1.2). File tài liệu — không bắt buộc chạy trong CI.

# ===== dcs-jobs.service =====
[Unit]
Description=DCS - tac vu nen hang ngay (chuyen hieu luc, sinh ra soat, leo thang)
After=network.target postgresql.service dcs.service

[Service]
Type=oneshot
User=dcs
Group=dcs
WorkingDirectory=/opt/dcs
EnvironmentFile=/opt/dcs/.env
# Chạy tác vụ nền (profile 'jobs' → DailyJobsRunner): chuyển hiệu lực, sinh rà
# soát, leo thang, dọn phiên; xong là SpringApplication.exit trả bộ nhớ.
ExecStart=/usr/bin/java -jar /opt/dcs/dcs-0.1.0.jar --spring.profiles.active=jobs
# Sau đó xử lý một tệp OCR/bóc tách (profile 'ocr' → OcrWorker, mỗi lần một tệp — RAM 1 GB).
ExecStartPost=/usr/bin/java -jar /opt/dcs/dcs-0.1.0.jar --spring.profiles.active=ocr
SyslogIdentifier=dcs-jobs
